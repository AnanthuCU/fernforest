{
  "name": "fernforest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:portal",
    "dev:portal": "cd apps/fernforest-portal && next dev -p 3000",
    "dev:service": "node apps/BackEnd/server.js",
    "dev:backend": "node apps/BackEnd/server.js",
    "migrate:backend": "node apps/BackEnd/src/utils/migrate.js",
    "test:backend": "node --test apps/BackEnd/tests/health.test.js",
    "dev:all": "concurrently \"npm run dev:portal\" \"npm run dev:backend\"",
    "build": "cd apps/fernforest-portal && next build",
    "build:portal": "cd apps/fernforest-portal && next build",
    "build:service": "node apps/BackEnd/server.js",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "tailwind-merge": "^2.4.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@nx/next": "^23.1.0",
    "@nx/node": "^23.1.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "nx": "^23.1.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5"
  }
}
