{
  "name": "fernforest-backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/BackEnd",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "node server.js",
        "cwd": "apps/BackEnd"
      }
    },
    "migrate-db": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node src/utils/migrate.js",
        "cwd": "apps/BackEnd"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "!{projectRoot}/.env"],
      "options": {
        "command": "node --test \"tests/**/*.test.js\"",
        "cwd": "apps/BackEnd"
      }
    }
  }
}
