{
  "name": "fernforest-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/fernforest-service",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{workspaceRoot}/dist/apps/fernforest-service"],
      "options": {
        "outputPath": "dist/apps/fernforest-service",
        "main": "apps/fernforest-service/server.js",
        "tsConfig": "apps/fernforest-service/tsconfig.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/fernforest-service/server.js"
      }
    }
  }
}
