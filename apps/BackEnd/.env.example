# Either a full connection string...
DATABASE_URL=postgres://postgres:password@localhost:5432/fernforest
# ...or individual settings
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=fernforest
DB_SSL=false

# Bearer token required for /api/admin/* (must match the portal's ADMIN_API_TOKEN)
ADMIN_API_TOKEN=change-me
# Comma-separated list of origins allowed to call this API from a browser
CORS_ORIGIN=http://localhost:3000
